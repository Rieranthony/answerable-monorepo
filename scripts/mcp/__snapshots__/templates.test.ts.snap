exports[`every file of a new MCP, for a fixed name and date, with the status tool: src/db/schema.ts 1`] = `
"import * as pg from "drizzle-orm/pg-core"

// The tables of the acme MCP, in its own Postgres schema, acme. After a change here, bun mcp db acme generate writes the
// migration; bun mcp add tool adds the table a new domain needs.
//
// Every table has organisation_id and the organisationIsolation policy, with .enableRLS(): Postgres then limits every query to the
// caller's organisation, even one that forgets to filter. A table without them is shared by every organisation: a reviewed exception,
// with a comment above it saying why.
//
//   export const projects = acmeSchema.table("projects", {
//     id: pg.uuid().primaryKey().$defaultFn(() => Bun.randomUUIDv7()),
//     organisation_id: pg.uuid().notNull(),
//     name: pg.text().notNull(),
//   }, table => [organisationIsolation(table.organisation_id)]).enableRLS()
//
// The runtime role reads and writes every table here. To narrow that, export grants from src/db/grants.ts, which
// bun mcp db acme migrate reads:
//
//   import type { Grant } from "@answerable/mcp-postgres"
//   export const grants: Grant[] = [{ table: "projects", privileges: ["select", "insert"] }]
export const acmeSchema = pg.pgSchema("acme")
"
`;

exports[`every file of a new MCP, for a fixed name and date, with the status tool: src/tools/acme-status.ts 1`] = `
"// One tool = one thing the caller can do. Hosts call this tool acme_acme_status in the Toolbox, acme_status alone.
//
// name: <domain>.<operation>, from the caller's side: notes.list, projects.search, rfis.create.
//   Never the vendor or the transport (sharepoint_query), never a mode switch (manage_notes).
//   Unique in this MCP; the CLI and defineProvider refuse a second one.
//
// description: the model reads only this to choose the tool. Say what it does, when to use it,
//   its limits (page size, what it cannot see) and what the ids mean. 40 to 1,000 characters.
//   Good: "List the notes of a project, newest first, 20 per page. Use projects.search first to find the project id."
//   Bad: "Gets notes."
//
// input and output: Zod objects. Describe every field (.describe("…")): hosts show it to the model.
//   A list takes limit and cursor and returns items, next_cursor and has_more (the conformance kit checks it).
//
// execute: gets the checked input and the caller: person, organisation and db. Row-level security limits every query to
//   the caller's organisation, so no query filters on it by hand. Throw ToolError for a failure the caller can fix.
import { z } from "zod"
import { defineTool } from "../mcp"

export const acmeStatus = defineTool({
  name: "acme.status",
  description: "Report that acme is running and who is calling: your name and your organisation's. Replace it with the MCP's first real tool.",
  input: z.object({}),
  output: z.object({
    status: z.string().describe("ok while the MCP runs"),
    person: z.string().describe("Your name"),
    organisation: z.string().describe("Your organisation's name"),
  }),
  example: {},
  async execute(_input, { person, organisation }) {
    return { status: "ok", person: person.name, organisation: organisation.name }
  },
})
"
`;

exports[`every file of a new MCP, for a fixed name and date, with the status tool: src/tools/acme-status.test.ts 1`] = `
"import { expect, test } from "bun:test"
import { createTestMcp } from "@answerable/mcp-postgres/testing"
import { provider } from "../provider"

test("acme_status says who is calling and from which organisation", async () => {
  const mcp = await createTestMcp(provider)
  try {
    const client = await mcp.connect({ person: { name: "Ada Lovelace" }, organisation: { name: "Acme" } })
    const result = await client.callTool({ name: "acme_status", arguments: {} })
    expect(result.structuredContent).toEqual({ status: "ok", person: "Ada Lovelace", organisation: "Acme" })
  } finally {
    await mcp.close()
  }
})
"
`;

exports[`a new MCP whose first tool is a read has its domain's table; a mutation's file and test: src/db/schema.ts 1`] = `
"import { organisationIsolation } from "@answerable/mcp-postgres"
import * as pg from "drizzle-orm/pg-core"

// The tables of the acme MCP, in its own Postgres schema, acme. After a change here, bun mcp db acme generate writes the
// migration; bun mcp add tool adds the table a new domain needs.
//
// Every table has organisation_id and the organisationIsolation policy, with .enableRLS(): Postgres then limits every query to the
// caller's organisation, even one that forgets to filter. A table without them is shared by every organisation: a reviewed exception,
// with a comment above it saying why.
//
//   export const projects = acmeSchema.table("projects", {
//     id: pg.uuid().primaryKey().$defaultFn(() => Bun.randomUUIDv7()),
//     organisation_id: pg.uuid().notNull(),
//     name: pg.text().notNull(),
//   }, table => [organisationIsolation(table.organisation_id)]).enableRLS()
//
// The runtime role reads and writes every table here. To narrow that, export grants from src/db/grants.ts, which
// bun mcp db acme migrate reads:
//
//   import type { Grant } from "@answerable/mcp-postgres"
//   export const grants: Grant[] = [{ table: "projects", privileges: ["select", "insert"] }]
export const acmeSchema = pg.pgSchema("acme")

// The notes table: each organisation's rows. The id is a UUID v7, so ids sort by creation.
export const notes = acmeSchema.table("notes", {
  id: pg.uuid().primaryKey().$defaultFn(() => Bun.randomUUIDv7()),
  organisation_id: pg.uuid().notNull(),
  title: pg.text().notNull(),
  created_at: pg.timestamp({ withTimezone: true }).notNull().defaultNow(),
}, table => [organisationIsolation(table.organisation_id)]).enableRLS()
"
`;

