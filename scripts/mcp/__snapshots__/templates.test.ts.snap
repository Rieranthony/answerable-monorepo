"// The acme MCP: what it is for, its version and its tools. bun mcp add tool adds a tool above each "bun mcp: tools" line.
import { defineProvider } from "@answerable/mcp"
import { database } from "./mcp"
import { acmeStatus } from "./tools/acme-status"
// bun mcp: tools

export const provider = defineProvider({
  id: "acme",
  description: "Notes for construction projects: list, read and add notes on a project.",
  version: "2026-10-25",
  database,
  tools: [
    acmeStatus,
    // bun mcp: tools
  ],
})
"
`;

