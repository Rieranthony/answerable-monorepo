exports[`a new MCP whose first tool is a read has its domain's table; a mutation's file and test: src/tools/notes-list.ts 1`] = `
"// One tool = one thing the caller can do. Hosts call this tool acme_notes_list in the Toolbox, notes_list alone.
//
// name: <domain>.<operation>, from the caller's side: notes.list, projects.search, rfis.create.
//   Never the vendor or the transport (sharepoint_query), never a mode switch (manage_notes).
//   Unique in this MCP; the CLI and defineProvider refuse a second one.
//
// description: the model reads only this to choose the tool. Say what it does, when to use it,
//   its limits (page size, what it cannot see) and what the ids mean. 40 to 1,000 characters.
//   Good: "List the notes of a project, newest first, 20 per page. Use projects.search first to find the project id."
//   Bad: "Gets notes."
//
// input and output: Zod objects. Describe every field (.describe("…")): hosts show it to the model.
//   A list takes limit and cursor and returns items, next_cursor and has_more (the conformance kit checks it).
//
// execute: gets the checked input and the caller: person, organisation and db. Row-level security limits every query to
//   the caller's organisation, so no query filters on it by hand. Throw ToolError for a failure the caller can fix.
import { desc, lt } from "drizzle-orm"
import { z } from "zod"
import * as schema from "../db/schema"
import { defineTool } from "../mcp"

const item = z.object({
  id: z.uuid().describe("The row's id"),
  title: z.string(),
  created_at: z.iso.datetime().describe("When it was added"),
})

export const notesList = defineTool({
  name: "notes.list",
  description: "List the notes of the caller's organisation, newest first, 20 per page.",
  input: z.object({
    limit: z.number().int().min(1).max(100).default(20).describe("Items per page, 1 to 100"),
    cursor: z.uuid().optional().describe("next_cursor from the previous page; omit it for the first page"),
  }),
  output: z.object({
    items: z.array(item).describe("Newest first"),
    next_cursor: z.uuid().nullable().describe("The cursor of the next page, or null on the last"),
    has_more: z.boolean(),
  }),
  example: { limit: 5 },
  async execute({ limit, cursor }, { db }) {
    const table = schema.notes
    const rows = await db.select().from(table).where(cursor ? lt(table.id, cursor) : undefined).orderBy(desc(table.id)).limit(limit + 1)
    const items = rows.slice(0, limit).map(row => ({ id: row.id, title: row.title, created_at: row.created_at.toISOString() }))
    const has_more = rows.length > limit
    return { items, next_cursor: has_more ? items.at(-1)!.id : null, has_more }
  },
})
"
`;

exports[`a new MCP whose first tool is a read has its domain's table; a mutation's file and test: src/tools/notes-list.test.ts 1`] = `
"import { expect, test } from "bun:test"
import { createTestMcp } from "@answerable/mcp-postgres/testing"
import * as schema from "../db/schema"
import { provider } from "../provider"

type Page = { items: { title: string }[]; next_cursor: string | null; has_more: boolean }

test("notes_list lists the caller's organisation's rows only, newest first, a page at a time", async () => {
  const mcp = await createTestMcp(provider)
  try {
    const [mine, theirs] = [crypto.randomUUID(), crypto.randomUUID()]
    for (const title of ["First", "Second", "Third"]) await mcp.asOrganisation(mine, () => mcp.db.insert(schema.notes).values({ organisation_id: mine, title }))
    await mcp.asOrganisation(theirs, () => mcp.db.insert(schema.notes).values({ organisation_id: theirs, title: "Theirs" }))
    const client = await mcp.connect({ organizationId: mine })
    const first = (await client.callTool({ name: "notes_list", arguments: { limit: 2 } })).structuredContent as Page
    expect(first.items.map(item => item.title)).toEqual(["Third", "Second"])
    expect(first.has_more).toBe(true)
    const second = await client.callTool({ name: "notes_list", arguments: { limit: 2, cursor: first.next_cursor } })
    expect(second.structuredContent).toMatchObject({ items: [{ title: "First" }], next_cursor: null, has_more: false })
    const other = await mcp.connect({ organizationId: theirs })
    expect((await other.callTool({ name: "notes_list", arguments: {} })).structuredContent).toMatchObject({ items: [{ title: "Theirs" }] })
  } finally {
    await mcp.close()
  }
})
"
`;

exports[`a new MCP whose first tool is a read has its domain's table; a mutation's file and test: README.md 1`] = `
"# acme MCP

Notes for construction projects: list, read and add notes on a project.

- **Where it runs** (\`"serve": "both"\` in \`mcp.json\`): both in the Toolbox, which mounts it from \`mcps/toolbox/src/mounted.generated.ts\`; hosts call its tools \`acme_<domain>_<operation>\` at the Toolbox's one URL, \`http://localhost:47400/mcp\` locally (\`bun run toolbox:dev\`); and on its own URL, \`/acme/mcp\` on the standalone server, which serves it from \`mcps/standalone/src/served.generated.ts\`: \`http://localhost:47510/acme/mcp\` locally (\`bun run standalone:dev\`).
- **Its tables** (\`"database": "own"\`): in schema \`acme\` of its own database, \`answerable_mcp_acme\`, each limited to the caller's organisation by Postgres. Its tests use schema \`acme\` of \`answerable_mcps_test\`.
- **Its tools:** one file each in \`src/tools\`, with its test, listed in \`src/provider.ts\`. \`manifest.json\` is their contract.

\`\`\`sh
bun mcp add tool acme <domain.operation> --description "<what it does, when to use it, its limits>"
bun mcp check acme
bun mcp db acme generate
bun mcp db acme migrate
\`\`\`

Run them from the repository root, or from \`mcps/acme\` without the name. \`add tool\` writes a read tool, or with \`--mutation\` a change, with its test and its table, then checks the MCP. \`check\` runs the typecheck, the lint and the tests, with [the conformance kit](../../apps/web/content/docs/mcp/testing.mdx) and a 100% coverage gate; it rewrites a stale \`manifest.json\` and says to commit it. After a change to \`src/db/schema.ts\`, \`db generate\` writes the migration into \`drizzle/\`: review and commit it. \`db migrate\` migrates the local development schema. \`bun mcp\` writes \`mcp.json\`; change \`serve\` and \`database\` there.

Guides: [Make an MCP](../../apps/web/content/docs/mcp/create.mdx), [Add a tool](../../apps/web/content/docs/mcp/add-a-tool.mdx), [Your MCP's database](../../apps/web/content/docs/mcp/database.mdx), [Sign-in](../../apps/web/content/docs/mcp/sign-in.mdx), [Ship it](../../apps/web/content/docs/mcp/deploy.mdx), [Test an MCP](../../apps/web/content/docs/mcp/testing.mdx).
"
`;

