{
  "name": "answerable",
  "private": true,
  "workspaces": [
    "apps/*",
    "mcps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run env:up && turbo run dev --filter='./apps/*'",
    "mcp:dev": "bun --env-file=.env run --filter @answerable/mcp-e2e dev",
    "mcp:test": "bun run --filter @answerable/auth --filter @answerable/mcp --filter @answerable/mcp-e2e test",
    "env:up": "docker compose up -d --wait",
    "env:down": "docker compose down",
    "env:reset": "docker compose down -v",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "mcp:test:e2e": "bun mcps/e2e/scripts/acceptance.ts"
  },
  "packageManager": "bun@1.3.1",
  "devDependencies": {
    "turbo": "^2.10.12"
  }
}
