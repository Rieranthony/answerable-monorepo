{
  "name": "answerable",
  "private": true,
  "workspaces": [
    "apps/*",
    "infra/*",
    "mcps/*",
    "packages/*",
    "scripts"
  ],
  "scripts": {
    "dev": "bun run env:up && turbo run dev --filter='./apps/*'",
    "mcp:dev": "bun --env-file=.env run --filter @answerable/mcp-e2e dev",
    "toolbox:dev": "bun --env-file=.env run --filter @answerable/mcp-toolbox dev",
    "admin:dev": "bun --env-file=.env run --filter @answerable/mcp-admin dev",
    "mcp": "bun scripts/mcp/cli.ts",
    "mcp:test": "bun run --filter @answerable/auth --filter @answerable/config --filter @answerable/id-admin --filter @answerable/infra-ops --filter @answerable/infra-pipeline --filter '@answerable/mcp*' --filter @answerable/scripts test",
    "mcp:check": "turbo run typecheck lint test --filter",
    "env:inventory": "bun scripts/env-inventory.ts",
    "env:up": "docker compose up -d --wait",
    "env:down": "docker compose down",
    "env:reset": "docker compose down -v",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "mcp:test:e2e": "bun run --filter @answerable/acceptance test",
    "infra:test": "bun run --filter @answerable/infra-k8s test",
    "infra:check": "bun infra/check.ts"
  },
  "packageManager": "bun@1.3.1",
  "devDependencies": {
    "turbo": "^2.10.12"
  }
}
