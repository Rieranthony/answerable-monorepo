{
  "name": "answerable",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run env:up && turbo run dev",
    "env:up": "docker compose up -d --wait",
    "env:down": "docker compose down",
    "env:reset": "docker compose down -v",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "packageManager": "bun@1.3.1",
  "devDependencies": {
    "turbo": "^2.10.12"
  }
}
