# Local environment — matches docker-compose.yml. Copy to .env.
DATABASE_URL=postgres://answerable:answerable@localhost:47432/answerable_id
TEST_DATABASE_URL=postgres://answerable:answerable@localhost:47432/answerable_id_test
REDIS_URL=redis://localhost:47379
BETTER_AUTH_URL=http://localhost:47300
BETTER_AUTH_SECRET=local-dev-only-change-me-at-least-32-chars
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:47100
AUTH_PAGES_URL=http://localhost:47100
DATABASE_POOL_MAX=5
DATABASE_POOL_IDLE_TIMEOUT_MS=10000
DATABASE_CONNECTION_TIMEOUT_MS=5000
OPENAPI_ENABLED=true

# Platform organisation whose members may hold platform:* scopes.
# PLATFORM_ORGANIZATION_SLUG=answerable
# Admin API RFC 8707 resource indicator (aud); defaults to ${BETTER_AUTH_URL}/api/admin.
# ADMIN_RESOURCE_IDENTIFIER=http://localhost:47300/api/admin

# Organisation name, read by bun run bootstrap only (default: Answerable).
# PLATFORM_ORGANIZATION_NAME=Answerable
# Corporate email domain, read by bun run bootstrap only (required).
# PLATFORM_DOMAIN=answerable.org
# Corporate OIDC issuer URL, read by bun run bootstrap only (required).
# PLATFORM_SSO_ISSUER=https://issuer.example.com
# Corporate OIDC client ID, read by bun run bootstrap only (required).
# PLATFORM_SSO_CLIENT_ID=
# Corporate OIDC client secret, read by bun run bootstrap only (required).
# PLATFORM_SSO_CLIENT_SECRET=
# Discovery URL override, read by bun run bootstrap only (default: issuer + /.well-known/openid-configuration).
# PLATFORM_SSO_DISCOVERY_ENDPOINT=
# First machine client ID, read by bun run bootstrap only (default: answerable-bootstrap).
# BOOTSTRAP_CLIENT_ID=answerable-bootstrap

# Set for the first run; generate with openssl rand -base64 48.
# ROOT_ADMIN_SECRET=
# Set to true for break-glass only.
ROOT_ADMIN_BREAK_GLASS=false
