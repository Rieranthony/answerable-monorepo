# Local environment — matches docker-compose.yml. Copy to .env.
DATABASE_URL=postgres://answerable_id_runtime:answerable@localhost:47432/answerable_id
# Per-statement server-side deadline; separate from lock waits, pool checkout and total request time.
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_LOCK_TIMEOUT_MS=2000
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000
# Active application handlers per service instance; rejects excess work without queuing.
# Fixed route/status summaries and instantaneous pool counts; 0 disables reporting.
OPERATIONAL_LOG_INTERVAL_MS=30000
# Schema-owner credentials are for migration tooling only. Every non-test DATABASE_URL must use a provisioned runtime role.
DATABASE_RUNTIME_ROLE=answerable_id_runtime
DATABASE_MIGRATION_URL=postgres://answerable:answerable@localhost:47432/answerable_id
TEST_DATABASE_URL=postgres://answerable:answerable@localhost:47432/answerable_id_test
REDIS_URL=redis://localhost:47379
BETTER_AUTH_URL=http://localhost:47300
BETTER_AUTH_SECRET=local-dev-only-change-me-at-least-32-chars
# Optional provider-native application-secret ring: first version writes, retained versions decrypt.
# Keep BETTER_AUTH_SECRET for legacy ciphertext. Never reuse upstream/replay keys.
# Promotion changes browser-cookie signing: coordinate replicas and require fresh sign-in.
# BETTER_AUTH_SECRETS=2:<new-random-secret-at-least-32-characters>,1:<previous-random-secret-at-least-32-characters>
# Required before SSO logins. Independent upstream token keys; first version writes, all listed versions read.
# Generate each value as random 32 bytes, canonical base64url (43 characters, no padding). Never reuse auth/replay keys.
# UPSTREAM_TOKEN_SECRETS=[{"version":1,"value":"<canonical-base64url-key>"}]
# Install the initial schema and provision the restricted runtime role before starting ID; see apps/id/README.md.

# Required in production: non-empty origin-only URLs, with no path or trailing slash.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:47100

# Set explicitly to the deployed pages URL in production; localhost is only a local default.
AUTH_PAGES_URL=http://localhost:47100
# Native refresh-response retry interval. Zero treats rotated-token reuse as replay.
OAUTH_REFRESH_REUSE_INTERVAL_SECONDS=0
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT_MS=10000
DATABASE_CONNECTION_TIMEOUT_MS=5000
# Defaults to false in production and true otherwise; uncomment to override.
# OPENAPI_ENABLED=true

# Platform organisation whose members may hold platform:* scopes.
# PLATFORM_ORGANIZATION_SLUG=answerable
# PLATFORM_ORGANIZATION_NAME=Answerable
# Admin API RFC 8707 resource indicator (aud); defaults to ${BETTER_AUTH_URL}/api/admin.
# ADMIN_RESOURCE_IDENTIFIER=http://localhost:47300/api/admin

# Set for the first run; generate with openssl rand -base64 48.
# ROOT_ADMIN_SECRET=
# Set to true for break-glass only.
ROOT_ADMIN_BREAK_GLASS=false

# Required for every client and resource administration mutation. Use independent random 32-byte keys from deployment secret storage.
# OPERATION_REPLAY_CONFIG={"activeKeyId":"v1","keys":{"v1":"<canonical-base64url-key>"}}
# Maintenance process only; do not provide its credentials to the application.
# DATABASE_RETENTION_URL=postgres://answerable_id_retention:<password>@localhost:47432/answerable_id

# Required in production: comma-separated ingress proxy CIDRs; restrict service access to these proxies.
# TRUSTED_PROXY_CIDRS=10.0.0.0/24,2001:db8::/64
