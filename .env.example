# Local environment — matches docker-compose.yml. Copy to .env.
# default.env lists every variable in the monorepo with empty values.
DATABASE_URL=postgres://answerable_id_runtime:answerable@localhost:47432/answerable_id
# Schema-owner credentials are for migration tooling only. Every non-test DATABASE_URL must use a provisioned runtime role.
DATABASE_RUNTIME_ROLE=answerable_id_runtime
DATABASE_MIGRATION_URL=postgres://answerable:answerable@localhost:47432/answerable_id
TEST_DATABASE_URL=postgres://answerable:answerable@localhost:47432/answerable_id_test
# Required everywhere; the admin API's resource is this URL with /api/admin.
BETTER_AUTH_URL=http://localhost:47300
BETTER_AUTH_SECRET=local-dev-only-change-me-at-least-32-chars
# Optional provider-native application-secret ring: first version writes, retained versions decrypt.
# Keep BETTER_AUTH_SECRET for legacy ciphertext.
# Promotion changes browser-cookie signing: coordinate replicas and require fresh sign-in.
# BETTER_AUTH_SECRETS=2:<new-random-secret-at-least-32-characters>,1:<previous-random-secret-at-least-32-characters>
# Install the initial schema and provision the restricted runtime role before starting ID; see apps/id/README.md.

# Platform OAuth callback for local sign-in: http://localhost:47300/auth/sso/callback
# Google Web application client ID; set together with GOOGLE_CLIENT_SECRET.
# GOOGLE_CLIENT_ID=
# Google client secret; environment only, never in platform SSO rows.
# GOOGLE_CLIENT_SECRET=
# Multi-tenant Entra Application (client) ID; set together with MICROSOFT_CLIENT_SECRET.
# MICROSOFT_CLIENT_ID=
# Entra client secret; environment only, rotate before its expiry.
# MICROSOFT_CLIENT_SECRET=
# Real Google/Microsoft sign-in locally also needs their exact origins in BETTER_AUTH_TRUSTED_ORIGINS:
# Microsoft: https://login.microsoftonline.com,https://graph.microsoft.com
# Google: https://accounts.google.com,https://oauth2.googleapis.com,https://www.googleapis.com,https://openidconnect.googleapis.com
# Allow outbound HTTPS to those origins too.

# Other browser origins allowed to call the API with cookies, plus identity-provider endpoint origins.
# The ID origin itself is always trusted. Production requires a non-empty list.
# Use origin-only URLs, with no path or trailing slash.
BETTER_AUTH_TRUSTED_ORIGINS=

DATABASE_POOL_MAX=20

# Set for the first run; generate with openssl rand -base64 48.
# ROOT_ADMIN_SECRET=
# Set to true for break-glass only.
ROOT_ADMIN_BREAK_GLASS=false

# Required in production: comma-separated ingress proxy CIDRs; restrict service access to these proxies.
# TRUSTED_PROXY_CIDRS=10.0.0.0/24,2001:db8::/64

# Local e2e MCP (bun run mcp:dev): register the resource in Answerable ID first.
# MCP_ID_ISSUER=http://localhost:47300
# MCP_RESOURCE_URL=http://localhost:47500/mcp
# MCP_PORT=47500

# The disposable database that @answerable/mcp-postgres's tests reset; nothing else may use it.
MCP_POSTGRES_TEST_DATABASE_URL=postgres://answerable:answerable@localhost:47432/answerable_mcp_postgres_test

# Local Toolbox (bun run toolbox:dev): migrate with bun --env-file=.env run --filter @answerable/mcp-toolbox db:migrate, register its resource
# and a machine client in Answerable ID, then set the client's ID and secret. See apps/web/content/docs/toolbox/index.mdx.
# The Toolbox serves as the restricted runtime login and refuses the owner; the owner's URL is for db:migrate only, which provisions the role.
TOOLBOX_DATABASE_URL=postgres://answerable_toolbox_runtime:answerable@localhost:47432/answerable_toolbox
TOOLBOX_DATABASE_MIGRATION_URL=postgres://answerable:answerable@localhost:47432/answerable_toolbox
TOOLBOX_DATABASE_RUNTIME_ROLE=answerable_toolbox_runtime
TOOLBOX_TEST_DATABASE_URL=postgres://answerable:answerable@localhost:47432/answerable_toolbox_test
TOOLBOX_ID_ISSUER=http://localhost:47300
TOOLBOX_RESOURCE_URL=http://localhost:47400/mcp
# The address to listen on; the container image sets 0.0.0.0.
TOOLBOX_HOST=127.0.0.1
TOOLBOX_PORT=47400
TOOLBOX_ID_ADMIN_RESOURCE=http://localhost:47300/api/admin
# TOOLBOX_ID_CLIENT_ID=toolbox-hub
# TOOLBOX_ID_CLIENT_SECRET=
# Export spans over OTLP/HTTP, for example to a local collector.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Local admin MCP (bun run admin:dev): staff only. Migrate with bun --env-file=.env run --filter @answerable/mcp-admin db:migrate, register its
# resource and a machine client of the platform organisation in Answerable ID, then set the client's ID and secret. See apps/web/content/docs/admin/index.mdx.
ADMIN_ID_ISSUER=http://localhost:47300
ADMIN_RESOURCE_URL=http://localhost:47520/mcp
# The address to listen on; the container image sets 0.0.0.0.
ADMIN_HOST=127.0.0.1
ADMIN_PORT=47520
# The admin MCP serves as the restricted runtime login and refuses the owner; the owner's URL is for db:migrate only, which provisions the role.
ADMIN_DATABASE_URL=postgres://answerable_admin_runtime:answerable@localhost:47432/answerable_admin
ADMIN_DATABASE_MIGRATION_URL=postgres://answerable:answerable@localhost:47432/answerable_admin
ADMIN_DATABASE_RUNTIME_ROLE=answerable_admin_runtime
ADMIN_TEST_DATABASE_URL=postgres://answerable:answerable@localhost:47432/answerable_admin_test
ADMIN_ID_ADMIN_RESOURCE=http://localhost:47300/api/admin
# ADMIN_ID_CLIENT_ID=admin-mcp
# ADMIN_ID_CLIENT_SECRET=
# The Toolbox's admin resource, for enabling the Toolbox for an organisation; optional.
# ADMIN_TOOLBOX_ADMIN_RESOURCE=http://localhost:47400/admin
# How recent a sign-in the critical operations need, in seconds.
ADMIN_FRESH_SECONDS=1800

# The independent /oauth-test consumer reads OAUTH_TEST_ISSUER,
# OAUTH_TEST_CLIENT_ID, OAUTH_TEST_CLIENT_SECRET and OAUTH_TEST_REDIRECT_URI
# from apps/web/.env.local. See apps/web/.env.example; keep its client secret
# separate from ID's root, database and Microsoft credentials.

# Deployment (infra/README.md): nothing here. Every deployment credential lives in a GitHub environment and is read by
# the workflows; none is ever exported in a shell or written to a file, since Bun loads .env by itself and a token here
# would sit on disk in plain text. The ops Jobs' OPS_* are set by charts/answerable.
