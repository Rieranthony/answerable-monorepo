# Local environment for apps/web. Copy to apps/web/.env.local — Next.js reads
# env files from the app directory, not the monorepo root.
#
# Attio → Workspace settings → Developers → "+ New access token". Scopes:
#   record_permission:read-write, object_configuration:read,
#   list_entry:read-write, list_configuration:read
# Leave ATTIO_API_KEY empty locally to log signups to the terminal instead.
ATTIO_API_KEY=
# Optional: the list to add people to, as a UUID or api_slug. Find it with
#   curl -s -H "Authorization: Bearer $ATTIO_API_KEY" https://api.attio.com/v2/lists
ATTIO_WAITLIST_LIST=
