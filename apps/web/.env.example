# Local environment for apps/web. Copy to apps/web/.env.local — Next.js reads
# env files from the app directory, not the monorepo root.
# Browser-facing URL for the Answerable ID API.
NEXT_PUBLIC_ID_URL=http://localhost:47300
#
# Waitlist signups go to a Google Sheet, one row per address. Leave all three
# variables empty locally to log signups to the terminal instead; production
# needs all three. One-time setup:
#   1. console.cloud.google.com → create a project (any name).
#   2. APIs & Services → Library → "Google Sheets API" → Enable.
#   3. IAM & Admin → Service Accounts → Create service account (no roles).
#   4. Open it → Keys → Add key → Create new key → JSON. Keep the file.
#   5. Create a blank Google Sheet and share it with the "client_email" from
#      the JSON as Editor. Row 1 is written on first use: email,
#      first_seen_at, last_seen_at, country_code, country_name, contacted.
#      The checkbox in contacted is added to each row when it is written.
#      Times are in the sheet's own timezone (File → Settings).
#   6. The spreadsheet id is the long segment of the sheet's URL:
#      https://docs.google.com/spreadsheets/d/<GOOGLE_SHEETS_ID>/edit
GOOGLE_SHEETS_ID=
# "client_email" from the JSON key.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# "private_key" from the JSON key, on one line, \n kept, in double quotes:
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
