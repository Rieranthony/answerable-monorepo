{
  "name": "@answerable/id",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "start": "bun src/server.ts",
    "build": "bun build src/server.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts drizzle.config.ts drizzle.test.config.ts --max-warnings 0",
    "test": "bun run db:test:push && bun run test:coverage",
    "test:coverage": "bun test",
    "db:test:push": "bun scripts/reset-test-schema.ts && drizzle-kit push --config drizzle.test.config.ts --force"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.2",
    "@better-auth/oauth-provider": "1.7.2",
    "@hono/standard-validator": "0.2.2",
    "@scalar/hono-api-reference": "0.9.46",
    "better-auth": "1.7.2",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.5",
    "hono-openapi": "1.3.1",
    "pg": "8.16.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/bun": "1.3.1",
    "@types/pg": "8.15.6",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1"
  }
}
