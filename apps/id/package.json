{
  "name": "@answerable/id",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/build-css.ts && bun --env-file=../../.env --hot src/server.ts",
    "build": "bun scripts/build-css.ts dist/tailwind.css && bun build src/server.ts --outdir dist --target bun && bun build scripts/migrate.ts --outdir dist/scripts --target bun",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts drizzle.config.ts --max-warnings 0",
    "test": "bun run db:test:migrate && bun run test:coverage",
    "test:coverage": "bun test --timeout 15000",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:regenerate": "bun scripts/regenerate-migrations.ts",
    "db:migrate": "bun scripts/migrate.ts",
    "db:test:migrate": "bun scripts/reset-test-database.ts"
  },
  "dependencies": {
    "@better-auth/core": "1.7.2",
    "@better-auth/drizzle-adapter": "1.7.2",
    "@better-auth/oauth-provider": "1.7.2",
    "@better-auth/sso": "1.7.2",
    "@hono/standard-validator": "0.2.2",
    "better-auth": "1.7.2",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.5",
    "hono-openapi": "1.3.1",
    "jose": "6.2.10",
    "pg": "8.23.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@answerable/auth": "workspace:*",
    "@answerable/ui": "workspace:*",
    "@eslint/js": "9.39.5",
    "@types/bun": "1.3.1",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "hono-tailwind": "3.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1"
  }
}
