{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "web-only",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--filter",
        "web",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    }
  ]
}
