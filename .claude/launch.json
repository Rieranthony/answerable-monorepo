{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 47100,
      "autoPort": true
    },
    {
      "name": "web-only",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--filter",
        "web",
        "dev"
      ],
      "port": 47100,
      "autoPort": true
    },
    {
      "name": "id",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "--env-file=.env",
        "run",
        "--filter",
        "@answerable/id",
        "dev"
      ],
      "port": 47300
    }
  ]
}
