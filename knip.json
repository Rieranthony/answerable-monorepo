{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": [
    "**/coverage/**",
    "**/dist/**",
    "**/.next/**"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts"
      ]
    },
    "apps/id": {
      "entry": [
        "src/server.ts",
        "src/**/*.test.ts",
        "src/__tests__/preload.ts",
        "scripts/*.ts",
        "drizzle.config.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "scripts/**/*.ts"
      ]
    },
    "apps/web": {
      "entry": [
        "app/**/*.{ts,tsx}",
        "proxy.ts",
        "**/*.test.ts",
        "scripts/*.ts",
        "next.config.mjs"
      ],
      "project": [
        "**/*.{ts,tsx,mjs}"
      ]
    },
    "packages/design": {
      "entry": [
        "src/**/*.test.{ts,tsx}",
        "scripts/*.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "scripts/*.ts"
      ]
    },
    "packages/*": {
      "entry": [
        "src/index.ts",
        "src/testing.ts",
        "src/**/*.test.ts",
        "scripts/*.ts",
        "src/build-worker.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "infra/*": {
      "entry": [
        "src/cli.ts",
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "mcps/*": {
      "entry": [
        "src/server.ts",
        "src/**/*.test.ts",
        "scripts/*.ts",
        "src/docs/*.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "scripts": {
      "entry": [
        "*.ts",
        "mcp/cli.ts",
        "mcp/**/*.test.ts"
      ],
      "ignoreDependencies": [
        "drizzle-kit"
      ],
      "project": [
        "*.ts",
        "mcp/**/*.ts"
      ]
    },
    "infra/k8s": {
      "entry": [
        "*.test.ts",
        "local/*.test.ts"
      ],
      "project": [
        "*.ts",
        "local/*.ts"
      ]
    }
  }
}
