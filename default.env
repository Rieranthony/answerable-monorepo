# Every environment variable in the monorepo, with empty values. Tracked in git: never write real values here.
# Generated by bun run env:inventory from each service's definition (packages/config/README.md): change the definition, then run it.
# Locally, only the credentials in .env.example have no default: copy it to .env, and apps/web/.env.example to apps/web/.env.local.
# A line in .env overrides a default. Most variables refuse an empty value, so copy only the lines you fill in.
# What ID's mean in production: docs/06-deploying-answerable-id.md.

# ID: apps/id/src/config.ts, read from the root .env by bun dev
# development, test or production (unset, development): the first two fill unset variables with local defaults, production none; the images set production
NODE_ENV=
# The port ID listens on
PORT=
# ID's Postgres URL as its restricted runtime login, never the schema owner
DATABASE_URL=
# ID's origin: the issuer, the pages' origin and the base of the admin API's audience
BETTER_AUTH_URL=
# The application secret, at least 32 characters: signs cookies and encrypts what ID stores
BETTER_AUTH_SECRET=
# The rotation ring, version:secret pairs separated by commas: the first writes, every one decrypts
BETTER_AUTH_SECRETS=
# The Google platform application's client ID; set it with GOOGLE_CLIENT_SECRET or leave both unset
GOOGLE_CLIENT_ID=
# The Google platform application's client secret
GOOGLE_CLIENT_SECRET=
# The Entra platform application's client ID; set it with MICROSOFT_CLIENT_SECRET or leave both unset
MICROSOFT_CLIENT_ID=
# The Entra platform application's client secret
MICROSOFT_CLIENT_SECRET=
# Origins trusted besides ID's own, separated by commas: browser origins and identity-provider endpoints; production requires them
BETTER_AUTH_TRUSTED_ORIGINS=
# The root bearer, at least 32 characters, for the first run; it stops working once a person holds platform:write
ROOT_ADMIN_SECRET=
# true keeps the root bearer working after a person holds platform:write; for break-glass only
ROOT_ADMIN_BREAK_GLASS=
# The ingress proxies' networks, IPv4 or IPv6, separated by commas; production requires them
TRUSTED_PROXY_CIDRS=
# Connections per process; size it with docs/06's formula against the database's limit
DATABASE_POOL_MAX=

# ID migration: apps/id/scripts/env.ts, read by scripts/migrate.ts
# ID's Postgres URL as the schema owner, for the migration only
DATABASE_MIGRATION_URL=
# The restricted role the migration provisions and ID serves as
DATABASE_RUNTIME_ROLE=

# ID test database: apps/id/src/__tests__/test-database.ts, for ID's tests
# The disposable database ID's test suite resets, named answerable_id_test
TEST_DATABASE_URL=

# Toolbox: mcps/toolbox/src/environment.ts, read from the root .env by bun run toolbox:dev
# The Toolbox's Postgres URL as its restricted runtime login, never the schema owner
TOOLBOX_DATABASE_URL=
# The shared MCP database, answerable_mcps, as the Toolbox's serving login, answerable_mcps_toolbox, which takes each mounted MCP's runtime role
TOOLBOX_MCPS_DATABASE_URL=
# The prefix of the MCPs' roles in the shared database: mcp; a test that serves its own database names its own
TOOLBOX_MCPS_ROLE_PREFIX=
# The Answerable ID issuer whose tokens the Toolbox accepts
TOOLBOX_ID_ISSUER=
# The Toolbox's own URL, the audience of the tokens it accepts
TOOLBOX_RESOURCE_URL=
# The address to listen on: loopback unless a container or a proxy in front needs another
TOOLBOX_HOST=
# The port the Toolbox listens on
TOOLBOX_PORT=
# The Toolbox's machine client in ID, toolbox-hub, with platform:read and platform:write, registered as the Toolbox's docs show
TOOLBOX_ID_CLIENT_ID=
# The Toolbox machine client's secret
TOOLBOX_ID_CLIENT_SECRET=
# ID's admin API, the audience of the machine client's tokens
TOOLBOX_ID_ADMIN_RESOURCE=
# Where to export spans over OTLP/HTTP, such as a local collector; unset, none are exported
OTEL_EXPORTER_OTLP_ENDPOINT=

# Toolbox migration: mcps/toolbox/scripts/env.ts, read by scripts/migrate.ts
# The Toolbox's Postgres URL as the schema owner, for the migration only
TOOLBOX_DATABASE_MIGRATION_URL=
# The restricted role the migration provisions and the Toolbox serves as
TOOLBOX_DATABASE_RUNTIME_ROLE=

# Toolbox test database: mcps/toolbox/src/test/database.ts, for the Toolbox's tests
# The disposable database the Toolbox's tests reset, named answerable_toolbox_test
TOOLBOX_TEST_DATABASE_URL=

# admin MCP: mcps/admin/src/environment.ts, read from the root .env by bun run admin:dev
# The Answerable ID issuer whose tokens the admin MCP accepts
ADMIN_ID_ISSUER=
# The admin MCP's own URL, the audience of the tokens it accepts
ADMIN_RESOURCE_URL=
# The address to listen on: loopback unless a container or a proxy in front needs another
ADMIN_HOST=
# The port the admin MCP listens on
ADMIN_PORT=
# The admin MCP's Postgres URL as its restricted runtime login, never the schema owner
ADMIN_DATABASE_URL=
# The admin MCP's machine client in ID, admin-mcp, owned by the platform organisation, registered as the admin MCP's docs show
ADMIN_ID_CLIENT_ID=
# The admin MCP machine client's secret
ADMIN_ID_CLIENT_SECRET=
# ID's admin API, the audience of the machine client's tokens
ADMIN_ID_ADMIN_RESOURCE=
# The Toolbox's admin API, for enabling the Toolbox for an organisation; unset, that is refused
ADMIN_TOOLBOX_ADMIN_RESOURCE=
# How recent an upstream sign-in a critical operation needs, in seconds; unset, 1,800
ADMIN_FRESH_SECONDS=

# admin MCP migration: mcps/admin/scripts/env.ts, read by scripts/migrate.ts
# The admin MCP's Postgres URL as the schema owner, for the migration only
ADMIN_DATABASE_MIGRATION_URL=
# The restricted role the migration provisions and the admin MCP serves as
ADMIN_DATABASE_RUNTIME_ROLE=

# admin MCP test database: mcps/admin/src/test/database.ts, for the admin MCP's tests
# The disposable database the admin MCP's tests reset, named answerable_admin_test
ADMIN_TEST_DATABASE_URL=

# standalone server: mcps/standalone/src/environment.ts, read from the root .env by bun run standalone:dev
# The standalone server's origin: each MCP it serves is the resource <origin>/<name>/mcp, the audience of its tokens
STANDALONE_ORIGIN=
# The Answerable ID issuer whose tokens the standalone server accepts
STANDALONE_ID_ISSUER=
# The address to listen on: loopback unless a container or a proxy in front needs another
STANDALONE_HOST=
# The port the standalone server listens on
STANDALONE_PORT=
# The standalone server's Postgres URL, for intents and evidence, as its restricted runtime login, never the owner
STANDALONE_DATABASE_URL=
# The shared MCP database, answerable_mcps, as the standalone server's serving login, answerable_mcps_standalone, which takes each served MCP's runtime role
STANDALONE_MCPS_DATABASE_URL=
# The prefix of the MCPs' roles in the shared database: mcp; a test that serves its own database names its own
STANDALONE_MCPS_ROLE_PREFIX=
# The standalone server's machine client in ID, standalone-hub, with platform:read, through which it reads who is calling
STANDALONE_ID_CLIENT_ID=
# The standalone server machine client's secret
STANDALONE_ID_CLIENT_SECRET=
# ID's admin API, the audience of the machine client's tokens
STANDALONE_ID_ADMIN_RESOURCE=

# standalone server migration: mcps/standalone/scripts/env.ts, read by scripts/migrate.ts
# The standalone server's Postgres URL as its owner, for the migration only
STANDALONE_DATABASE_MIGRATION_URL=
# The restricted role the migration provisions and the standalone server serves as
STANDALONE_DATABASE_RUNTIME_ROLE=

# standalone server test database: mcps/standalone/src/test/database.ts, for the standalone server's tests
# The disposable database the standalone server's tests reset, named answerable_standalone_test
STANDALONE_TEST_DATABASE_URL=

# ops: infra/ops/src/commands.ts, set by charts/answerable for the bootstrap, register and make-admin Jobs (infra/ops/README.md)
# bootstrap and register: the namespace of the Secrets they write, read by src/kubernetes.ts; unset, the service account's
OPS_NAMESPACE=
# bootstrap: the managed database's administrative login (CREATEDB and CREATEROLE), a URL with sslmode=verify-full
OPS_DATABASE_ADMIN_URL=
# bootstrap: where the chart mounts the database's certificate authority, for the services' URLs
OPS_DATABASE_SSLROOTCERT=
# register and make-admin: ID's origin
OPS_ID_URL=
# register: a staff token, used over OPS_ID_ROOT_SECRET once ID's root secret is locked
OPS_ID_TOKEN=
# register and make-admin: ID's root secret, ROOT_ADMIN_SECRET
OPS_ID_ROOT_SECRET=
# register: the Toolbox's origin
OPS_TOOLBOX_URL=
# register: the admin MCP's origin
OPS_ADMIN_MCP_URL=
# register and make-admin: the platform organisation's slug
OPS_PLATFORM_SLUG=
# register: the port of Claude Code's OAuth callback that the clients allow
OPS_CLAUDE_CALLBACK_PORT=
# register: the Deployments to start once their client secrets exist, name=replicas separated by commas
OPS_START_DEPLOYMENTS=
# register: the staff email domain to connect to the platform organisation, with OPS_ENTRA_TENANT
OPS_STAFF_DOMAIN=
# register: the staff directory's Entra tenant ID, a GUID, with OPS_STAFF_DOMAIN
OPS_ENTRA_TENANT=
# make-admin: the email of the staff member, signed in once, to make the first administrator
OPS_ADMIN_EMAIL=

# MCP Postgres test databases: packages/mcp-postgres/src/testing.ts, for the package's own tests and every MCP's (testMcpDatabase)
# The disposable database @answerable/mcp-postgres's own tests reset, named answerable_mcp_postgres_test
MCP_POSTGRES_TEST_DATABASE_URL=
# The shared MCP test database, answerable_mcps_test, as a superuser of the development Postgres: each MCP's tests reset only their own schema there
MCPS_TEST_DATABASE_URL=

# bun mcp: scripts/mcp/config.ts, read by bun mcp db migrate and bun mcp new
# The shared MCP database, answerable_mcps, as a superuser of the development Postgres: bun mcp db migrate provisions and migrates an MCP's local schema there, and an own MCP's database beside it
MCPS_DATABASE_ADMIN_URL=

# web: apps/web, read from apps/web/.env.local by Next.js (apps/web/.env.example)
# The waitlist's spreadsheet ID; locally, without it and the two below, a sign-up is logged instead; production needs all three
GOOGLE_SHEETS_ID=
# The service account that writes the waitlist's sheet
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The service account's private key, on one line with \n kept
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# The /oauth-test consumer's Answerable ID, in development only
OAUTH_TEST_ISSUER=
# The /oauth-test consumer's client in ID
OAUTH_TEST_CLIENT_ID=
# The /oauth-test consumer's client secret
OAUTH_TEST_CLIENT_SECRET=
# The /oauth-test consumer's callback, http://localhost:47100/api/oauth-test/callback
OAUTH_TEST_REDIRECT_URI=

# GitHub environment: read by the workflows, never from a .env file (infra/README.md)
# The environment's Civo account API key; the owner pastes it
CIVO_TOKEN=
# A Cloudflare token scoped to the environment's zone only; the owner pastes it
CLOUDFLARE_API_TOKEN=
# A token that writes this environment's secrets, for the bootstrap workflow and Terraform; the owner pastes it
GH_SECRETS_TOKEN=
# The Terraform state's object store key ID; the bootstrap workflow writes it
STATE_ACCESS_KEY_ID=
# The Terraform state's object store secret; the bootstrap workflow writes it
STATE_SECRET_ACCESS_KEY=
# The cluster's API server, for the deploy step; Terraform writes it
KUBE_SERVER=
# The cluster's certificate authority, for the deploy step; Terraform writes it
KUBE_CA=
# The deployer's token, for the deploy step; Terraform writes it
KUBE_TOKEN=

# infra tooling: read by bun run infra:test and bun run infra:check
# 1 keeps the kind stack's cluster after bun run infra:test
INFRA_STACK_KEEP=
# Moves infra:check's Terraform provider cache
TF_PLUGIN_CACHE_DIR=
