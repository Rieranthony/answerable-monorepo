# Every environment variable in the monorepo, with empty values. Tracked in git: never write real values here.
# Working local values: copy .env.example to .env, and apps/web/.env.example to apps/web/.env.local.
# Most variables reject an empty string, so fill in a line or delete it before using a copy.
# What each one means in production: docs/06-deploying-answerable-id.md.
# The apps/id test suite fails when a variable it reads is missing from this file.

# apps/id: read from the root .env (bun --env-file=.env)

# Runtime
NODE_ENV=
PORT=
OPENAPI_ENABLED=
OPERATIONAL_LOG_INTERVAL_MS=
PROTOCOL_SWEEP_INTERVAL_MS=
PROTOCOL_SWEEP_BATCH=

# Issuer, trusted origins and OAuth
BETTER_AUTH_URL=
BETTER_AUTH_TRUSTED_ORIGINS=

# Ingress
TRUSTED_PROXY_CIDRS=

# Secrets: each family is independent
BETTER_AUTH_SECRET=
BETTER_AUTH_SECRETS=
UPSTREAM_TOKEN_SECRETS=
ROOT_ADMIN_SECRET=
ROOT_ADMIN_BREAK_GLASS=

# Platform applications: set each client ID and secret pair together, or leave both out
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Platform organisation and admin API
PLATFORM_ORGANIZATION_SLUG=
PLATFORM_ORGANIZATION_NAME=
ADMIN_RESOURCE_IDENTIFIER=

# Database connection and limits
DATABASE_URL=
DATABASE_POOL_MAX=
DATABASE_POOL_IDLE_TIMEOUT_MS=
DATABASE_CONNECTION_TIMEOUT_MS=
DATABASE_STATEMENT_TIMEOUT_MS=
DATABASE_LOCK_TIMEOUT_MS=
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=

# Tooling: migrations and the test database
DATABASE_MIGRATION_URL=
DATABASE_RUNTIME_ROLE=
TEST_DATABASE_URL=

# apps/web: read from apps/web/.env.local by Next.js
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# MCP consumers
MCP_ID_ISSUER=
MCP_RESOURCE_URL=
MCP_PORT=

# packages/mcp-postgres: the disposable database its tests reset
MCP_POSTGRES_TEST_DATABASE_URL=

# mcps/toolbox: read from the root .env (bun run toolbox:dev)
TOOLBOX_DATABASE_URL=
TOOLBOX_DATABASE_MIGRATION_URL=
TOOLBOX_DATABASE_RUNTIME_ROLE=
TOOLBOX_TEST_DATABASE_URL=
TOOLBOX_ID_ISSUER=
TOOLBOX_RESOURCE_URL=
TOOLBOX_HOST=
TOOLBOX_PORT=
TOOLBOX_ID_CLIENT_ID=
TOOLBOX_ID_CLIENT_SECRET=
TOOLBOX_ID_ADMIN_RESOURCE=
OTEL_EXPORTER_OTLP_ENDPOINT=

# mcps/admin: read from the root .env (bun run admin:dev)
ADMIN_ID_ISSUER=
ADMIN_RESOURCE_URL=
ADMIN_HOST=
ADMIN_PORT=
ADMIN_DATABASE_URL=
ADMIN_DATABASE_MIGRATION_URL=
ADMIN_DATABASE_RUNTIME_ROLE=
ADMIN_TEST_DATABASE_URL=
ADMIN_ID_CLIENT_ID=
ADMIN_ID_CLIENT_SECRET=
ADMIN_ID_ADMIN_RESOURCE=
ADMIN_TOOLBOX_ADMIN_RESOURCE=
ADMIN_FRESH_SECONDS=

# Independent development-only OAuth consumer; server-side values.
OAUTH_TEST_ISSUER=
OAUTH_TEST_CLIENT_ID=
OAUTH_TEST_CLIENT_SECRET=
OAUTH_TEST_REDIRECT_URI=

# infra: never in a .env file. Every deployment credential lives in a GitHub environment (infra/README.md): the five
# the owner pastes (CIVO_TOKEN, CLOUDFLARE_API_TOKEN, GH_SECRETS_TOKEN and the MICROSOFT_* pair above), the ones the
# bootstrap workflow generates (STATE_ACCESS_KEY_ID, STATE_SECRET_ACCESS_KEY and ID's three secrets above) and the ones
# Terraform writes (KUBE_SERVER, KUBE_CA, KUBE_TOKEN). The workflows read them; the chart sets the ops Jobs' OPS_*.
CIVO_TOKEN=
CLOUDFLARE_API_TOKEN=
GH_SECRETS_TOKEN=
STATE_ACCESS_KEY_ID=
STATE_SECRET_ACCESS_KEY=

# infra/pipeline: the deploy workflows' cluster credentials, or yours to run the scripts by hand (infra/pipeline/README.md)
KUBE_SERVER=
KUBE_CA=
KUBE_TOKEN=

# infra/ops: the bootstrap, register and make-admin Jobs, set by charts/answerable (infra/ops/README.md)
OPS_NAMESPACE=
OPS_DATABASE_ADMIN_URL=
OPS_DATABASE_SSLROOTCERT=
OPS_ID_URL=
OPS_ID_TOKEN=
OPS_ID_ROOT_SECRET=
OPS_TOOLBOX_URL=
OPS_ADMIN_MCP_URL=
OPS_PLATFORM_SLUG=
OPS_CLAUDE_CALLBACK_PORT=
OPS_START_DEPLOYMENTS=
OPS_STAFF_DOMAIN=
OPS_ENTRA_TENANT=
OPS_ADMIN_EMAIL=

# infra tooling: INFRA_STACK_KEEP=1 keeps the kind stack's cluster; TF_PLUGIN_CACHE_DIR moves infra:check's provider cache
INFRA_STACK_KEEP=
TF_PLUGIN_CACHE_DIR=
