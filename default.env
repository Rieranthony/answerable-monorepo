# Every environment variable in the monorepo, with empty values. Tracked in git: never write real values here.
# Working local values: copy .env.example to .env, and apps/web/.env.example to apps/web/.env.local.
# Most variables reject an empty string, so fill in a line or delete it before using a copy.
# What each one means in production: docs/06-deploying-answerable-id.md.
# The apps/id test suite fails when a variable it reads is missing from this file.

# apps/id: read from the root .env (bun --env-file=.env)

# Runtime
NODE_ENV=
PORT=
OPENAPI_ENABLED=
OPERATIONAL_LOG_INTERVAL_MS=

# Issuer, sign-in pages and OAuth
BETTER_AUTH_URL=
AUTH_PAGES_URL=
BETTER_AUTH_TRUSTED_ORIGINS=
OAUTH_REFRESH_REUSE_INTERVAL_SECONDS=

# Ingress
TRUSTED_PROXY_CIDRS=

# Secrets: each family is independent
BETTER_AUTH_SECRET=
BETTER_AUTH_SECRETS=
UPSTREAM_TOKEN_SECRETS=
ROOT_ADMIN_SECRET=
ROOT_ADMIN_BREAK_GLASS=

# Platform applications: set each client ID and secret pair together, or leave both out
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Platform organisation and admin API
PLATFORM_ORGANIZATION_SLUG=
PLATFORM_ORGANIZATION_NAME=
ADMIN_RESOURCE_IDENTIFIER=

# Database connection and limits
DATABASE_URL=
DATABASE_POOL_MAX=
DATABASE_POOL_IDLE_TIMEOUT_MS=
DATABASE_CONNECTION_TIMEOUT_MS=
DATABASE_STATEMENT_TIMEOUT_MS=
DATABASE_LOCK_TIMEOUT_MS=
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=

# Tooling: migrations, the test database and the OpenAPI export
DATABASE_MIGRATION_URL=
DATABASE_RUNTIME_ROLE=
TEST_DATABASE_URL=
PUBLIC_ID_URL=

# Reserved: the Redis read cache is not used yet
REDIS_URL=

# apps/web: read from apps/web/.env.local by Next.js
NEXT_PUBLIC_ID_URL=
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
