{
  "name": "@answerable/mcp-admin",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "exports": {
    "./admin": "./src/admin.ts",
    "./migrate": "./src/db/migrate.ts",
    "./platform": "./src/platform.ts"
  },
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "start": "bun src/server.ts",
    "test": "bun run db:test:migrate && bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts drizzle.config.ts --max-warnings 0",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "bun scripts/migrate.ts",
    "db:test:migrate": "bun scripts/migrate.ts --test"
  },
  "dependencies": {
    "@answerable/config": "workspace:*",
    "@answerable/id-admin": "workspace:*",
    "@answerable/mcp": "workspace:*",
    "@answerable/mcp-platform": "workspace:*",
    "@answerable/mcp-postgres": "workspace:*",
    "drizzle-orm": "0.45.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/bun": "1.3.1",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1"
  }
}
