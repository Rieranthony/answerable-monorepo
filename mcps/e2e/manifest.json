    {
      "identity": "e2e/commit",
      "name": "e2e_commit",
      "kind": "commit",
      "description": "Commit an agent-class intent that a prepare tool returned: pass its intent_id and commit_token. Returns the receipt; calling again returns the same receipt with idempotent_replay true. An intent whose commit_tool is e2e_commit_confirmed answers APPROVAL_REQUIRED here.",
      "scopes": [
        "e2e:write"
      ],
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "intent_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "intent_id from the prepare tool's result"
          },
          "commit_token": {
            "type": "string",
            "description": "commit_token from the prepare tool's result; it works once"
          }
        },
        "required": [
          "intent_id",
          "commit_token"
        ],
        "additionalProperties": false
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "receipt_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "intent_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "status": {
            "type": "string",
            "const": "committed"
          },
          "results": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "applied_changes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "from": {
                  "default": null
                },
                "to": {
                  "default": null
                }
              },
              "required": [
                "path",
                "from",
                "to"
              ],
              "additionalProperties": false
            }
          },
          "effects_performed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "committed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "committed_by": {
            "type": "object",
            "properties": {
              "user_id": {
                "type": "string"
              },
              "membership_id": {
                "type": "string"
              },
              "client_id": {
                "type": "string"
              }
            },
            "required": [
              "user_id",
              "membership_id",
              "client_id"
            ],
            "additionalProperties": false
          },
          "idempotent_replay": {
            "type": "boolean"
          }
        },
        "required": [
          "receipt_id",
          "intent_id",
          "status",
          "results",
          "applied_changes",
          "effects_performed",
          "committed_at",
          "committed_by",
          "idempotent_replay"
        ],
        "additionalProperties": false
      }
    },
    {
