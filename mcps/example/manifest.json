            "description": "intent_id from the prepare tool's result"
          },
          "commit_token": {
            "type": "string",
            "description": "commit_token from the prepare tool's result; it works once"
          },
          "preview_summary": {
            "type": "string",
            "description": "The intent's preview.summary, word for word as the person saw it"
          }
        },
        "required": [
          "intent_id",
          "commit_token",
          "preview_summary"
        ],
        "additionalProperties": false
