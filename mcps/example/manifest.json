    {
      "identity": "example/notes.list",
      "name": "notes_list",
      "version": "2026-09-30",
      "kind": "read",
      "description": "List your organisation's notes, oldest first, 20 per page by default and at most 100. When has_more is true, pass next_cursor as cursor to read the next page.",
      "scopes": [
        "example:read"
      ],
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "limit": {
            "default": 20,
            "description": "Notes per page, 1 to 100",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "description": "next_cursor from the previous page; omit it for the first page",
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
