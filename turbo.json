{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "web#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../id/openapi.json",
        "../id/openapi.admin.json",
        "../../packages/auth/src/**",
        "../../packages/mcp/src/**",
        "../../mcps/*/src/**",
        "../../mcps/*/scripts/**",
        "../../mcps/*/manifest.json",
        "../../mcps/*/package.json",
        "../../scripts/mcp-templates.ts"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "web#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../id/openapi.json",
        "../id/openapi.admin.json",
        "../../packages/mcp/src/errors.ts",
        "../../*.md",
        "../../docs/**/*.md",
        "../../reports/**/*.md",
        "../../apps/*/*.md",
        "../../packages/*/*.md",
        "../../mcps/*/*.md"
      ],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["PORT"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "@answerable/mcp-e2e#test": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "@answerable/mcp#test": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "@answerable/auth#test": {
      "cache": false
    },
    "@answerable/acceptance#test": {
      "cache": false
    },
    "@answerable/scripts#test": {
      "cache": false
    },
    "@answerable/mcp-e2e#dev": {
      "cache": false,
      "persistent": true,
      "env": ["MCP_ID_ISSUER", "MCP_RESOURCE_URL", "MCP_PORT"]
    },
    "@answerable/mcp-toolbox#test": {
      "cache": false,
      "dependsOn": ["^build"],
      "passThroughEnv": ["TOOLBOX_*"]
    },
    "@answerable/mcp-toolbox#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["TOOLBOX_*", "OTEL_EXPORTER_OTLP_ENDPOINT"]
    },
    "lint": {},
    "typecheck": {},
    "@answerable/id#dev": {
      "cache": false,
      "persistent": true,
      "env": ["PORT"],
      "passThroughEnv": [
        "TEST_DATABASE_URL",
        "PLATFORM_ORGANIZATION_SLUG",
        "PLATFORM_ORGANIZATION_NAME",
        "ADMIN_RESOURCE_IDENTIFIER",
        "ROOT_ADMIN_SECRET",
        "ROOT_ADMIN_BREAK_GLASS",
        "DATABASE_*",
        "BETTER_AUTH_*",
        "UPSTREAM_TOKEN_SECRETS",
        "MICROSOFT_*",
        "GOOGLE_CLIENT_*",
        "TRUSTED_PROXY_CIDRS",
        "OPERATIONAL_LOG_INTERVAL_MS",
        "OAUTH_REFRESH_REUSE_INTERVAL_SECONDS",
        "OPENAPI_ENABLED"
      ]
    },
    "web#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["OAUTH_TEST_*"],
      "env": ["PORT"]
    },
    "@answerable/id#test": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "passThroughEnv": [
        "TEST_DATABASE_URL",
        "PLATFORM_ORGANIZATION_SLUG",
        "PLATFORM_ORGANIZATION_NAME",
        "ADMIN_RESOURCE_IDENTIFIER",
        "ROOT_ADMIN_SECRET",
        "ROOT_ADMIN_BREAK_GLASS",
        "DATABASE_*",
        "BETTER_AUTH_*",
        "UPSTREAM_TOKEN_SECRETS",
        "MICROSOFT_*",
        "GOOGLE_CLIENT_*",
        "TRUSTED_PROXY_CIDRS",
        "OPERATIONAL_LOG_INTERVAL_MS",
        "OAUTH_REFRESH_REUSE_INTERVAL_SECONDS",
        "OPENAPI_ENABLED"
      ]
    }
  },
  "globalEnv": [
    "GOOGLE_SHEETS_ID",
    "GOOGLE_SERVICE_ACCOUNT_EMAIL",
    "GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY"
  ]
}
