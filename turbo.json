{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "REDIS_URL",
    "BETTER_AUTH_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_TRUSTED_ORIGINS",
    "AUTH_PAGES_URL",
    "PLATFORM_ORGANIZATION_SLUG",
    "PLATFORM_ORGANIZATION_NAME",
    "ADMIN_RESOURCE_IDENTIFIER",
    "ROOT_ADMIN_SECRET",
    "ROOT_ADMIN_BREAK_GLASS",
    "GOOGLE_SHEETS_ID",
    "GOOGLE_SERVICE_ACCOUNT_EMAIL",
    "GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "web#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "../id/openapi.json", "../id/openapi.admin.json"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["PORT"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "@answerable/mcp-e2e#test": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "@answerable/mcp-base#test": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "@answerable/auth#test": {
      "cache": false
    },
    "@answerable/mcp-e2e#dev": {
      "cache": false,
      "persistent": true,
      "env": ["MCP_ID_ISSUER", "MCP_ID_JWKS_URL", "MCP_RESOURCE_URL", "MCP_RESOURCE_INSTANCE_ID", "MCP_RECORDS_PATH", "MCP_ALLOW_LOCAL_HTTP", "MCP_PORT"]
    },
    "lint": {},
    "typecheck": {}
  }
}
