{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "web#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../DESIGN.md",
        "../id/openapi.json",
        "../id/openapi.admin.json",
        "../../packages/auth/src/**",
        "../../packages/config/inventory.json",
        "../../packages/config/src/**",
        "../../packages/mcp/src/**",
        "../../packages/mcp-postgres/src/**",
        "../../mcps/*/src/**",
        "../../mcps/*/scripts/**",
        "../../mcps/*/manifest.json",
        "../../mcps/*/package.json",
        "../../scripts/mcp/**"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "web#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../id/openapi.json",
        "../id/openapi.admin.json",
        "../../packages/config/inventory.json",
        "../../packages/mcp/src/**",
        "../../scripts/mcp/**",
        "../../infra/pipeline/**",
        "../../.github/workflows/*.yml",
        "../../apps/id/src/**",
        "../../mcps/admin/src/**",
        "../../mcps/toolbox/src/**",
        "../../*.md",
        "../../docs/**/*.md",
        "../../reports/**/*.md",
        "../../apps/*/*.md",
        "../../packages/*/*.md",
        "../../mcps/*/*.md",
        "../../infra/**/*.md",
        "../../charts/**/*.md"
      ],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["PORT"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "@answerable/design#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "../../DESIGN.md", "../ui/src/styles/tokens.css"],
      "outputs": ["coverage/**"]
    },
    "@answerable/mcp-e2e#test": {
      "cache": false
    },
    "@answerable/mcp-platform#test": {
      "cache": false
    },
    "@answerable/mcp#test": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "@answerable/auth#test": {
      "cache": false
    },
    "@answerable/acceptance#test": {
      "cache": false
    },
    "@answerable/infra-k8s#test": {
      "cache": false
    },
    "@answerable/scripts#test": {
      "cache": false
    },
    "@answerable/id-admin#test": {
      "cache": false
    },
    "@answerable/infra-ops#test": {
      "cache": false
    },
    "@answerable/infra-pipeline#test": {
      "cache": false
    },
    "@answerable/mcp-postgres#test": {
      "cache": false
    },
    "@answerable/mcp-toolbox#test": {
      "cache": false,
      "dependsOn": ["^build"],
      "passThroughEnv": ["TOOLBOX_*"]
    },
    "@answerable/mcp-toolbox#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["TOOLBOX_*", "OTEL_EXPORTER_OTLP_ENDPOINT"]
    },
    "@answerable/mcp-admin#test": {
      "cache": false,
      "dependsOn": ["^build"],
      "passThroughEnv": ["ADMIN_*"]
    },
    "@answerable/mcp-admin#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["ADMIN_*"]
    },
    "lint": {},
    "typecheck": {},
    "@answerable/id#dev": {
      "cache": false,
      "persistent": true,
      "env": ["PORT"],
      "passThroughEnv": [
        "TEST_DATABASE_URL",
        "ID_HOST",
        "ROOT_ADMIN_SECRET",
        "ROOT_ADMIN_BREAK_GLASS",
        "DATABASE_*",
        "BETTER_AUTH_*",
        "MICROSOFT_*",
        "GOOGLE_CLIENT_*",
        "TRUSTED_PROXY_CIDRS"
      ]
    },
    "web#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["OAUTH_TEST_*"],
      "env": ["PORT"]
    },
    "@answerable/id#test": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "passThroughEnv": ["TEST_DATABASE_URL", "DATABASE_RUNTIME_ROLE"]
    }
  },
  "globalPassThroughEnv": ["MCP_POSTGRES_TEST_DATABASE_URL", "MCPS_TEST_DATABASE_URL", "MCPS_DATABASE_ADMIN_URL"],
  "globalEnv": [
    "GOOGLE_SHEETS_ID",
    "GOOGLE_SERVICE_ACCOUNT_EMAIL",
    "GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY"
  ]
}
