# Terraform's working directories and anything holding state: state carries the cluster's admin kubeconfig, the
# database's administrator password, the deployer's token, the edge's three private keys and the GitHub secrets'
# plaintext, and lives only in the environment's object store.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Local overrides, such as a backend switched to local state for an experiment, never belong in the repository.
*_override.tf

# Shared modules are never applied on their own: `terraform init` writes their lock files and they are not kept.
# The root's lock file is committed with hashes for darwin_arm64, linux_amd64 and linux_arm64.
modules/*/.terraform.lock.hcl
