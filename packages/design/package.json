{
  "name": "@answerable/design",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./parse": "./src/parse.ts",
    "./react": "./src/react.tsx",
    "./google-fonts.json": "./src/google-fonts.json"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\"",
    "generate": "bun scripts/generate.ts",
    "fonts": "bun scripts/fonts.ts"
  },
  "dependencies": {
    "@google/design.md": "0.4.0",
    "culori": "4.0.2",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@happy-dom/global-registrator": "21.0.4",
    "@types/bun": "1.3.1",
    "@types/culori": "4.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "^3.8.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1"
  }
}
